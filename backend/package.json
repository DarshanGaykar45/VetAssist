{
  "name": "vetassist-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "test": "node test-ai-clinic.js",
    "test:sync": "node scripts/verify-offline-sync.js",
    "test:all": "node scripts/verify-all.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
