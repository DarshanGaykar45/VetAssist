{
  "name": "vetassist",
  "version": "1.0.0",
  "private": true,
  "description": "VetAssist — Cattle Artificial Insemination (AI) Clinic Management System",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "setup": "cd backend && npm run setup",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
